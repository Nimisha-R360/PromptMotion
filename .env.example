# Copy to .env at the repo root: cp .env.example .env

# API (apps/api)
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://promptmotion:promptmotion@localhost:5433/promptmotion

# true = skip Claude and use the sample plan (no API key or cost). For trying the pipeline.
MOCK_LLM=false

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Claude, for the planning step. Leave unset to use another credential (e.g. `ant auth login`).
# ANTHROPIC_API_KEY=

# Needed in a later step (voiceover)
# TTS_API_KEY=
