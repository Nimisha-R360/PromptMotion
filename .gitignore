# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prompt Motion
/data
/runtime-dist
/.venv
architecture.png
*.log

# local databases (default lives in /data, but DATABASE_PATH can point elsewhere)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# local LLM model weights
*.gguf

# python
__pycache__/
*.py[cod]

# editors / OS
.vscode/
.idea/
*.swp
*~
Thumbs.db

# local Claude Code settings
.claude/settings.local.json
