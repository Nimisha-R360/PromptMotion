{
  "name": "@promptmotion/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc && concurrently -k -n tsc,api,worker -c gray,blue,magenta \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\" \"node --watch dist/worker.js\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsc && node dist/database/seed.js",
    "plan": "tsc && node dist/scripts/generate-plan.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@promptmotion/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-boss": "12.39.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.7",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
